# ============================================================
# Copy to .env  — LOCAL run ke liye yeh file kaafi hai (no AWS)
# Priority: OS env  >  .env  >  SSM (fallback)  >  code defaults
# ============================================================

ENV=local                       # local | dev | qa | stage | prod
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- SSM fallback ----
# local: default OFF. dev/qa/prod: default ON (missing keys SSM se aayengi)
SSM_FALLBACK=false
AWS_DEFAULT_REGION=us-east-1

# ---- Database (docker-compose ke pgvector container se match) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ragdb

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
JWT_SECRET_KEY=change-me-local-only
JWT_ALGORITHM=HS256

# ---- RAG pipeline (provider swap = sirf yeh values badlo) ----
LLM_PROVIDER=bedrock            # bedrock | sagemaker | ollama (Phase 2)
LLM_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
EMBED_PROVIDER=bedrock_cohere   # bedrock_cohere | sagemaker_mpnet | ollama
EMBED_MODEL_ID=cohere.embed-multilingual-v3
VECTORSTORE_PROVIDER=pgvector   # pgvector | bedrock_kb
EMBEDDINGS_COLLECTION=cb-netflix_embeddings

# Chunking (ab in-app, SSM ki zaroorat nahi)
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Chat memory
ENABLE_CHAT_MEMORY=true
CHAT_HISTORY_NO_OF_MSGS=5

# ---- Bedrock KB path (sirf VECTORSTORE_PROVIDER=bedrock_kb pe zaroori) ----
KNOWLEDGE_BASE_ID=
KB_DATASOURCE_ID=
BEDROCK_REGION=us-east-1

# ---- S3 (prompts override + document ingestion) ----
S3_BUCKET=

# ---- LangSmith (optional — empty rakho to tracing off) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cb-netflix-local

# ---- Integrations (Phase 6) ----
SENDGRID_API_KEY=
